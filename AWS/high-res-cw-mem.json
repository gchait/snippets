{
  "agent": {
    "metrics_collection_interval": 10
  },
  "metrics": {
    "force_flush_interval": 10,
    "metrics_collected": {
      "mem": {
        "measurement": [
          {
            "name": "used_percent",
            "rename": "MemoryUtilization",
            "unit": "Percent"
          }
        ]
      }
    },
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}",
      "AutoScalingGroupName": "${aws:AutoScalingGroupName}"
    },
    "aggregation_dimensions": [["AutoScalingGroupName"]]
  }
}
